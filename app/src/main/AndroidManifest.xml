<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Classic Bluetooth permissions (maxSdkVersion 30 keeps newer devices on
         the runtime BLUETOOTH_* model below). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Runtime permissions needed from Android 12 (API 31) on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Needed once a keyboard session runs in the foreground; declared now so
         the probe can be granted it on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app can be selected as a system input method. The BIND_INPUT_METHOD
         permission is signature-level and is enforced by the platform when the IME
         service is bound. -->
    <uses-permission android:name="android.permission.BIND_INPUT_METHOD" />

    <!-- The keyboard session must survive leaving the app, so it runs as a
         foreground service of the "connected device" kind (Android 14+ requires the
         type-specific permission too). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyforge">

        <activity
            android:name=".probe.ProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:label="@string/probe_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Minimal keyboard session used to verify a real keystroke end to end.
             Not exported: it owns a live HID registration and is opened from the
             probe screen. -->
        <activity
            android:name=".keyboard.KeyboardActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:label="@string/keyboard_title" />

        <!-- Owns the single HID registration and the host connection, so the
             keyboard keeps working after the user leaves the screen. -->
        <service
            android:name=".keyboard.KeyboardService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:label="@string/keyboard_title">
            <intent-filter>
                <action android:name="android.bluetooth.BluetoothHidDevice" />
            </intent-filter>
        </service>

        <!-- Input method flavour: the phone's own text editing stays available while the
             keystrokes go to the connected host. `exported="true"` is required - the
             system input-method manager binds it from outside the app. -->
        <service
            android:name=".ime.KeyforgeImeService"
            android:exported="true"
            android:label="@string/ime_service_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- The gear icon in the system input-method picker needs somewhere to go. -->
        <activity
            android:name=".ime.ImeSettingsActivity"
            android:exported="true"
            android:label="@string/ime_service_name" />
    </application>

</manifest>
